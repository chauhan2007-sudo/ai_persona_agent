# Copy this file to .env and fill in what you have.
# You need AT MOST ONE of these — if you leave both blank, the agent runs in
# "template mode" (no LLM calls, deterministic text) so you can still demo it.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Port the server listens on
PORT=3000

# How often (ms) each agent runs a discover -> judge -> publish cycle.
# 48hr eval suggests something like 30-90 min in production.
# For local testing/demo, drop this way down (e.g. 60000 = 1 min).
CYCLE_INTERVAL_MS=120000

# Delay (ms) before the FIRST cycle runs after init — kept > 0 on purpose so
# the feed is empty right after init, proving posts aren't dumped instantly.
FIRST_CYCLE_DELAY_MS=15000
